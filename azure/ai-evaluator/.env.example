# Azure AI Evaluator — local development environment
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and NEVER committed.
#
# NOTE: In production (Azure Functions), these same variables are set as
# App Settings (env vars) on the function app — NOT in a file. The code
# reads everything from process.env, so no credentials are ever hardcoded.

# Supabase (service role key — server-side only, bypasses RLS)
SUPABASE_URL=https://uqrgivzeklqehuqqqqyv.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# DeepSeek (OpenAI-compatible LLM)
DEEP_SEEK_BASE_URL=https://api.deepseek.com/v1
DEEP_SEEK_API=your_deepseek_api_key
DEEP_SEEK_MODEL=deepseek-chat

# Storage Queues (the evaluator's OWN queues) — $0, no paid messaging.
# In Azure the Function App reaches them through `AzureWebJobsStorage` via
# managed identity, so no connection string is needed in code. Locally, set
# `AzureWebJobsStorage` to a real storage connection string.

# Evaluator's own queues (one per concern — each scales independently)
EvaluationQueue=evaluation-requests
ResumeQueue=resume-requests
CoverLetterQueue=cover-letter-requests

# Backend Express /webhook/state (socket push) — must match backend
STATE_WEBHOOK_URL=https://ai-job-server-r2dk.onrender.com/webhook/state
STATE_WEBHOOK_SECRET=your_shared_webhook_secret

# Misc
DefaultCountryCode=hk
