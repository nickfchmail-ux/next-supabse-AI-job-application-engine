# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!azure/ai-evaluator/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Windows reserved names
nul

# ── Azure AI evaluator (deployed separately via `func publish`) ──────────
# NEVER commit credentials, local dev settings, or build output.
# (.env* files are covered by the global rule above; .env.example is kept.)
azure/ai-evaluator/local.settings.json
azure/ai-evaluator/dist/
azure/ai-evaluator/node_modules/
azure/ai-evaluator/package-lock.json

.vercel
.env*

# ── AI tooling config ────────────────────────────────────────────────────
# .deepcode/settings.json carries a base URL plus a LIVE API key. It was
# committed once (commit 1441570), which put that key into this public repo's
# history — so treat the key as compromised and rotate it. The file is still
# useful locally, so keep it on disk but never track it again.
.deepcode/
